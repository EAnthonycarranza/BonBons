# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored — never commit real credentials.

# MongoDB Atlas connection string.
# Get one free at https://mongodb.com/atlas -> Connect -> Drivers.
# Leave this blank and the site still runs, using built-in sample data.
MONGODB_URI=

# Password for the /admin dashboard. Change this before going live.
ADMIN_PASSWORD=changeme

# Secret used to sign the admin session cookie. Any long random string.
ADMIN_SECRET=please-change-this-to-something-long-and-random
