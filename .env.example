# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored — never commit real credentials.

# Set to the live HTTPS origin before a production build (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Password for the /admin dashboard. Change this before going live.
ADMIN_PASSWORD=changeme

# Supabase public project configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only token matching the deployed bonbons-data Edge Function.
# Use a long random value and never prefix it with NEXT_PUBLIC_.
BONBONS_INTERNAL_API_TOKEN=replace-with-a-long-random-token

# Gmail SMTP (server-only). Use a Google app password, not your account password.
GMAIL_USER=your-google-account@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
GMAIL_FROM_NAME="Bon Bon's Sweets & More"

# reCAPTCHA Enterprise CHECKBOX website key and server assessment settings.
# Enable challenges when creating the key; allow localhost for local development.
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=your-recaptcha-checkbox-site-key
GOOGLE_CLOUD_PROJECT_ID=your-google-cloud-project-id
GOOGLE_RECAPTCHA_API_KEY=your-server-only-google-api-key
RECAPTCHA_MIN_SCORE=0.5

# Secret used to sign the admin session cookie. Any long random string.
ADMIN_SECRET=please-change-this-to-something-long-and-random
